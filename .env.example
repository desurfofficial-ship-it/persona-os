# ============================================================
# Persona OS — environment (x OpenMuse integration)
# Copy to .env.local (real deployment) or use as-is in preview.
# ============================================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (real deployment; the preview backend runs without these) ---
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- AI: OpenRouter drives ALL Persona OS AI ---
# The CopilotKit agent (/api/copilotkit) points an OpenAI-compatible client at
# https://openrouter.ai/api/v1 with this key. Without it the agent falls back
# to the built-in preview model (planner loop in src/lib/zaiAgentAdapter.ts).
OPENROUTER_API_KEY=your_openrouter_key

# --- Direct Postgres (Prisma: preview SQLite by default; point at Supabase
#     Postgres or the OpenMuse stack's Postgres in production) ---
DATABASE_URL=postgres://user:password@host:5432/persona_os

# --- OpenMuse browser worker (agent computer: persistent profiles) ---
# Start in the OpenMuse repo with: pnpm dev:browser
# Full computer stack: docker build -t openmuse-computer:local apps/computer
BROWSER_WORKER_URL=http://127.0.0.1:8790
WORKER_TOKEN=change_me_32_char_random_value
# Goal checks degrade to direct fetch when the worker is absent.

# --- OpenMuse-compatible task/computer stack ---
COMPUTER_ENABLED=true
TASK_WORKER_ENABLED=true

# --- CopilotKit (optional; only for CopilotKit Cloud features) ---
CPK_INTELLIGENCE_API_KEY=

# --- OpenMuse access/security ---
OPENMUSE_ACCESS_KEY=change_me_24_char_min_value
TOKEN_ENCRYPTION_KEY=change_me_base64_32_bytes_value

# --- Preview alternatives (no keys needed) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
