// Persona OS — local preview schema (replaces Supabase tables in supabase/schema.sql)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model LocalUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // stored as "salt:sha256(salt:password)"
  createdAt DateTime @default(now())
}

model Persona {
  id               String   @id @default(uuid())
  userId           String
  name             String
  backstory        String   @default("")
  visualStyle      String?
  toneOfVoice      String?
  lifestylePillars Json?
  contentRules     Json?
  forbiddenTopics  Json?
  /// Curated "gold set" voice samples: [{ id, text, source, enabled, addedAt }]
  voiceSamples     Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model ContentDraft {
  id         String    @id @default(uuid())
  personaId  String
  userId     String
  type       String
  content    String
  posted     Boolean   @default(false)
  plannedFor DateTime?
  /// Manual performance log: { platform, views, likes, comments, loggedAt }
  /// or { entries: [{ platform, views, likes, comments, loggedAt }, ...] }
  metrics    Json?
  /// Scheduled auto-generate: the queued idea text before drafting.
  topic      String?
  /// True while the row is an idea waiting to be drafted on its due day.
  autoFill   Boolean   @default(false)
  /// Auto-extracted topic/mood tags (imported posts, vault pairing).
  tags       Json?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([personaId])
}

model Asset {
  id        String   @id @default(uuid())
  personaId String
  userId    String
  type      String // image | video | text | metric
  url       String?
  content   String?
  tags      Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([personaId])
}

/// OpenMuse-style Goals & Tracking adapted for Persona OS:
/// recurring public-page checks (e.g. TikTok tag pages) that raise
/// deduplicated alerts and can auto-generate content for the persona.
model ContentGoal {
  id         String    @id @default(uuid())
  personaId  String
  userId     String
  title      String
  /// daily | weekly
  recurrence String    @default("weekly")
  checkUrl   String
  /// active | paused | done
  status     String    @default("active")
  /// SHA-256 of the normalized page text from the last successful check.
  lastStateHash String?
  /// Short human-readable excerpt of the last snapshot (for the UI).
  lastStateSample String?
  lastCheckedAt DateTime?
  /// Earliest time the next check is allowed (driven by recurrence + backoff).
  nextCheckAt DateTime?
  /// Consecutive failures — drives exponential backoff and auto-pause at 5.
  failureCount Int     @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([personaId])
}

/// One alert per (goal, detected change). dedupeKey prevents re-alerting on
/// the same snapshot hash until the page changes again.
model GoalAlert {
  id        String   @id @default(uuid())
  goalId    String
  userId    String
  title     String
  body      String
  dedupeKey String   @unique
  /// Draft id when the trigger auto-generated content for the persona.
  draftId   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([goalId])
}
