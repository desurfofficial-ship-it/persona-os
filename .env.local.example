# Local preview / development
# Copy to .env.local and fill in real values. Never commit .env.local.

# --- AI (required for generation) ---
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional fallbacks if OpenRouter is unavailable
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Local preview auth (Prisma/SQLite backend) ---
# Generate a long random string. Do NOT use the default in production.
LOCAL_SESSION_SECRET=change-me-to-a-long-random-string

# Prisma SQLite (default path used by schema)
DATABASE_URL=file:./db/custom.db

# --- Optional: real Supabase (production path) ---
# Only needed if you swap the local shim for the real client in src/lib/supabase.ts
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
